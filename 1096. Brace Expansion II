class Solution:
    def braceExpansionII(self, s: str) -> list[str]:
        def parse(s):
            if not s:
                return {""}
            if "{" not in s and "," not in s:
                return {s}
            d=0
            t=[]
            for i,j in enumerate(s):
                if j=='{':
                    d+=1
                elif j=='}':
                    d-=1
                elif j==',' and d==0:
                    t.append(i) 
            if t:
                r=set()
                p=0
                for i in t:
                    r|=parse(s[p:i])
                    p=i+1
                r|=parse(s[p:])
                return r
            b=[]
            i=0
            while i<len(s):
                if s[i]=='{':
                    d=0
                    for j in range(i,len(s)):
                        if s[j]=='{':
                            d+=1
                        elif s[j]=='}':
                            d-=1
                        if d==0:
                            b.append(s[i+1:j])
                            i=j+1
                            break
                else:
                    j=i
                    while j<len(s) and s[j]!='{': 
                        j+=1
                    b.append(s[i:j])
                    i=j  
            r={""}
            for block in b:
                k=parse(block)  
                l = set()
                for j in r:
                    for m in k:
                        l.add(j+m)
                r=l                
            return r
        return sorted(list(parse(s)))
