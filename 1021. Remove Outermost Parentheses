class Solution:
    def removeOuterParentheses(self, s: str) -> str:
        o=0
        r=[]
        for i in s:
            if i=='(':
                if o>0:
                    r.append(i)
                o+=1
            else:
                o-=1
                if o>0:
                    r.append(i)
        return ("".join(r))
