class Solution:
    def findKthSmallest(self, coins: List[int], h: int) -> int:
        # a=[]
        # for i in coins:
        #     s=[]
        #     for j in range(k+1):
        #             s.append(i*j)
        #     a+=s
        #     a=sorted(set(a))
        # return a[k]
        p=[]
        for i in range(1,len(coins)+1):
            for j in combinations(coins,i):
                l=math.lcm(*j)
                s=1 if i%2==1 else -1
                p.append((l,s))
        k=1
        m=min(coins)*h
        while k<m:
            mid=(k+m)//2
            count=sum(s*(mid//l) for l,s in p)
            if count>=h:
                m=mid
            else:
                k=mid+1
        return k
