class Solution:
    def romanToInt(self, s: str) -> int:
        def find(n):
            if n == "I":
                return 1
            elif n == "V":
                return 5
            elif n == "X":
                return 10
            elif n == "L":
                return 50
            elif n == "C":
                return 100
            elif n == "D":
                return 500
            elif n == "M":
                return 1000

        k = list(s)
        i = 0
        t = 0
        while i < len(k) - 1:
            if find(k[i]) < find(k[i + 1]):
                t -= find(k[i])  
            else:
                t += find(k[i])  
            i += 1
        t += find(k[-1])
        return t
