class Solution:
    def canAliceWin(self, n: int) -> bool:
        if n<10:
            return False
        else:
            n-=10
        for i in range(9,0,-1):
            if n<i and i%2!=0:
                return True
            elif n<i and i%2==0:
                return False
            else:
                n-=i
