class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        nums=[abs(x) for x in nums]
        r=0
        nums.sort(reverse=True)
        i=0
        j=len(nums)-1
        while i <= j:
            r+=(nums[i]**2)
            i+=1
            if i<=j:
                r-=(nums[j]**2)
                j-=1
        return r
