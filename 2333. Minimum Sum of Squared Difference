class Solution:
    def minSumSquareDiff(self, nums1: list[int], nums2: list[int], k1: int, k2: int) -> int:
        i=0
        k=[]
        s=k1+k2
        while i<len(nums1):
            k.append(abs(nums1[i]-nums2[i]))
            i+=1
        if s>=sum(k):
            return 0
        k.sort(reverse=True)
        k.append(0) 
        i=0
        while s>0 and i<len(k)-1:
            d=k[i]-k[i+1]  
            c=i+1       
            if d*c<=s:
                s-=d*c
                i+=1
            else:
                q=s//c
                m=s%c
                for j in range(c):
                    k[j]=k[i]-q-(1 if j<m else 0)
                r = 0
                for v in k:
                    r += (v**2)
                return r
        for j in range(i):
            k[j]=k[i]
        r=0
        for v in k:
            r+=(v**2)
        return r
