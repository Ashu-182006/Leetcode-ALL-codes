class Solution:
    def maxNumberOfFamilies(self, n: int, re: List[List[int]]) -> int:
      t=n*2
        r=collections.defaultdict(set)
        for i,j in r:
            r[i].add(j)
        for i,j in r.items():
            l=not(j&{2, 3, 4, 5})
            k=not(j&{6, 7, 8, 9})
            m=not(j&{4, 5, 6, 7})
            if l and k:
                pass 
            elif l or k or m:
                t-=1
            else:
                t-=2
        return t
