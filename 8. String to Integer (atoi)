class Solution:
    def myAtoi(self, s: str) -> int:
        s=s.lstrip()
        if not s:
            return 0
        m=-1 if s[0] == '-' else 1
        if s[0] in '-+':
            s=s[1:]
        v=0
        for c in s:
            if not c.isdigit():
                break
            v=v*10+int(c)
        v*=m
        return max(-2**31, min(v,2**31-1))
