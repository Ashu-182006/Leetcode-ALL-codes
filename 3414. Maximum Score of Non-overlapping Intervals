class Solution:
    def maximumWeight(self, intervals: List[List[int]]) -> List[int]:
        A=sorted([l, r, w, i] for i, (l, r, w) in enumerate(intervals))
        S=[x[0] for x in A]
        n=len(A)
        dp=[[(0, []) for _ in range(5)] for _ in range(n + 1)]
        for i in range(n-1,-1,-1):
            nxt=bisect.bisect_right(S, A[i][1])
            for k in range(1, 5):
                w,idx=dp[nxt][k - 1]
                take=(w - A[i][2], sorted(idx + [A[i][3]]))
                dp[i][k]=min(dp[i + 1][k], take)
        return dp[0][4][1]
