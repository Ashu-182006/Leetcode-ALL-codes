class Solution:
    def canMakeArithmeticProgression(self, arr: List[int]) -> bool:
        arr.sort()
        m = arr[1]-arr[0]
        i =1
        while i!= len(arr) -1:
            if m== arr[i+1] - arr[i]:
                i+= 1   
            else:
                return (False)
        return (True)
