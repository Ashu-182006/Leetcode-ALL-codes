class Solution:
    def maxSumOfSquares(self, num: int, s: int) -> str:
        r=[]
        while s>9 and num>0:
            r.append('9')
            s-=9
            num-=1
        if s<10 and num>0:
            r.append(str(s))
            s=0
            num-=1
        if s==0 and num>0:
            r.append('0'*num)
        if s>0 and num==0:
            return ""
        return "".join(r)
