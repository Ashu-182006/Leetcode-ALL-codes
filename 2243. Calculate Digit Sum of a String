class Solution:
    def digitSum(self, s: str, t: int) -> str:
        while len(s)>t:
            k=[]
            a=0
            b=0
            for i in range(len(s)):
                if b<t:
                    a+=int(s[i])
                    b+=1
                else:
                    b=0
                    b+=1
                    k.append(a)
                    a=0
                    a+=int(s[i])
                if i==len(s)-1:
                    b=0
                    b+=1
                    k.append(a)
                    a=0
                    a+=int(s[i])
            s=""
            for j in range(len(k)):
                s+=str(k[j])
        return s
