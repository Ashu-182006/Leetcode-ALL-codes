        # if len(k)<1:
        #     k.append(s)
        # elif len(k)<2:
            
        #     k.append()
        # return k
        k=[]
        r=Counter(s)
        b=[]
        for i in r.keys():
            m=s.index(i)   
            e=s.rindex(i) 
            n=m
            v=0            
            while n<=e:
                if s.index(s[n])<m:
                    v=1
                    break
                e=max(e,s.rindex(s[n]))
                n+=1
            if v==0:
                b.append((e,m))
        b.sort()
        p=-1
        for i,j in b:
            if j>p:
                k.append(s[j:i+1])
                p=i
        if len(k)<1:
            k.append(s)
        return k
