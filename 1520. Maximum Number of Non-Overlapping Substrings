        # #         k.append(i)
        # r=Counter(s)
        # for i,j in r.items():
        #     if j==1:
        #         k.append(i)
        #     else:
        #         m=s.index(i)
        #         v=0
        #         for n in range(m,m+j):
        #             if s[n]!=i:
        #                 v=1
        #                 break
        #         if v==0:
