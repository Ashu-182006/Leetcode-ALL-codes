class Solution:
    def countIslands(self, g: List[List[int]], k: int) -> int:
        m,n=len(g),len(g[0])
        def f(i,j):
            if 0<=i<m and 0<=j<n and g[i][j]>0:
                v=g[i][j]
                g[i][j]=0
                return v+f(i+1,j)+f(i-1,j)+f(i,j+1)+f(i, j-1)
            return 0
        w=0
        for i in range(m):
            for j in range(n):
                if g[i][j]>0 and f(i,j)%k==0:
                    w+=1
        return w
