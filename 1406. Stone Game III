class Solution:
    def stoneGameIII(self, stoneValue: list[int]) -> str:
        n=len(stoneValue)
        p=[0]*(n + 1) 
        for i in range(n-1,-1,-1):
            t=0
            b=float('-inf')
            for k in range(3):
                if i+k<n:
                    t+=stoneValue[i+k]
                    b=max(b,t-p[i+k+1])
            p[i]=b
        if p[0]>0:
            return "Alice"
        elif p[0]<0:
            return "Bob"
        else:
            return "Tie"
